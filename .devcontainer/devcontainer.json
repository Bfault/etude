{
  "name": "Debian LaTeX Optimized",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "root",

  "containerEnv": {
    "TEXINPUTS": ".:${containerWorkspaceFolder}/utils/tex_utils//:"
  },

  "customizations": {
    "vscode": {
      "extensions": ["James-Yu.latex-workshop"],
      "settings": {
        "latex-workshop.latex.outDir": "%DIR%/build",
        "latex-workshop.latex.recipe.default": "latexmk (lualatex)",
        
        "latex-workshop.latex.tools": [
            {
                "name": "latexmk-lualatex",
                "command": "latexmk",
                "args": [
                    "-synctex=1",
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-lualatex",
                    "-outdir=%OUTDIR%",
                    "-r", "%WORKSPACE_FOLDER%/.latexmkrc",
                    "%DOC%"
                ],
                "env": {
                    "TEXINPUTS": "%WORKSPACE_FOLDER%/utils/tex_utils//:" 
                }
            },
            {
                "name": "latexmk-pdflatex-draft", 
                "command": "latexmk",
                "args": [
                    "-pdf",
                    "-pdflatex=pdflatex %O -draftmode %S",
                    "-synctex=1",
                    "-interaction=batchmode",
                    "-file-line-error",
                    "-outdir=%OUTDIR%",
                    "-r", "%WORKSPACE_FOLDER%/.latexmkrc",
                    "%DOC%"
                ],
                "env": {
                    "TEXINPUTS": "%WORKSPACE_FOLDER%/utils/tex_utils//:"
                }
            }
        ],
        "latex-workshop.latex.recipes": [
            { "name": "latexmk (lualatex)", "tools": ["latexmk-lualatex"] },
            { "name": "latexmk (pdflatex draft)", "tools": ["latexmk-pdflatex-draft"] }
        ]
      }
    }
  }
}